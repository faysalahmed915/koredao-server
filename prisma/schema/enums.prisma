enum UserRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  VENDOR
  /// Subscribed platform participant.
  /// Membership is granted by an ACTIVE `Subscription` and is layered ON TOP of
  /// the holder's base role (a CUSTOMER who subscribes keeps CUSTOMER authority
  /// and additionally counts as a MEMBER). It unlocks the paid marketplace
  /// actions: posting a job and taking a job.
  MEMBER
  CUSTOMER
}

enum SubscriptionPlan {
  MEMBER_MONTHLY
  MEMBER_QUARTERLY
  MEMBER_YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HandwritingStyle {
  CURSIVE
  PRINT
  MIXED
  MATH_EQUATION
}

enum AcademicLevel {
  UNDERGRADUATE
  GRADUATE
  POSTGRADUATE
  DOCTORATE
  OTHER
}

enum GigCategory {
  ASSIGNMENT
  LAB_REPORT
  THESIS_RESEARCH
  HANDWRITTEN_HARDCOPY
  MATH_PROBLEM_SOLVING
  PRESENTATION_SLIDES
  OTHER
}

enum GigTierType {
  SINGLE
  TIERED
}

enum AssignmentType {
  SOFTCOPY
  HARDCOPY
}

enum AssignmentStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrderStatus {
  PENDING_PAYMENT
  ESCROW_HELD
  IN_PROGRESS
  DELIVERED
  UNDER_REVIEW
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum EscrowStatus {
  AWAITING_PAYMENT
  HELD
  RELEASED_TO_VENDOR
  REFUNDED_TO_CUSTOMER
}

enum WalletTransactionType {
  ESCROW_RELEASE
  WITHDRAWAL
  REFUND
  PLATFORM_FEE
}

enum CheckpointStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REVISION_REQUESTED
}

/// Category of an in-app notification. Used for filtering in the notification
/// centre and for choosing an icon on the client.
enum NotificationType {
  /// Order lifecycle events (created, accepted, delivered, completed, dispute).
  ORDER
  /// Escrow movements (funded, released, refunded).
  ESCROW
  /// Payout / withdrawal events for helpers.
  PAYOUT
  /// New proposals on an assignment post.
  BID
  /// Vendor verification decisions.
  VERIFICATION
  /// Membership subscription events (activated, renewed).
  MEMBERSHIP
  /// Account & platform announcements.
  SYSTEM
}

