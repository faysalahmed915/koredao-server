model Order {
  id                 String         @id @default(cuid())
  orderNumber        String         @unique
  customerId         String
  customer           User           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  vendorProfileId    String
  vendorProfile      VendorProfile  @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  gigId              String?
  gig                Gig?           @relation(fields: [gigId], references: [id], onDelete: SetNull)
  assignmentId       String?
  assignment         Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  bidId              String?
  packageName        String?
  title              String
  totalAmount        Float
  platformFee        Float
  netVendorAmount    Float
  status             OrderStatus    @default(PENDING_PAYMENT)
  deadline           DateTime
  maxRevisions       Int            @default(1)
  usedRevisions      Int            @default(0)
  deliveredAt        DateTime?
  autoReleaseAt      DateTime?
  completedAt        DateTime?
  deliveryFiles      String[]       @default([])
  deliveryNotes      String?        @db.Text
  revisionNotes      String?        @db.Text
  disputeReason      String?        @db.Text
  disputeEvidenceUrl String?        @db.Text
  disputeResolvedAt  DateTime?
  // Agreement handshake for the pre-payment target sidebar flow.
  // customerAcceptedAt: set when a customer initiates from an accepted bid.
  // vendorAcceptedAt: set when the vendor accepts a gig-order the customer opened.
  customerAcceptedAt DateTime?
  vendorAcceptedAt   DateTime?
  escrowHolding      EscrowHolding?
  checkpoints        ProjectCheckpoint[]
  conversation       Conversation?
  moderationRequests ModerationRequest[]
  moderatorAdminRequests ModeratorAdminRequest[]
  agentSessions      AgentSession[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([customerId])
  @@index([vendorProfileId])
  @@index([status])
  @@index([autoReleaseAt])
  // Idempotency: one order per accepted assignment+bid combination.
  // Nullable components (gig orders have null assignmentId/bidId) allow
  // multiple NULLs per Postgres unique semantics, so gig orders are unaffected.
  @@unique([assignmentId, bidId], name: "order_assignmentId_bidId_key")
  @@map("order")
}

model EscrowHolding {
  id             String       @id @default(cuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Float
  status         EscrowStatus @default(AWAITING_PAYMENT)
  paymentGateway String?
  transactionRef String?
  fundedAt       DateTime?
  releasedAt     DateTime?
  refundedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("escrow_holding")
}

model VendorWallet {
  id              String              @id @default(cuid())
  vendorProfileId String              @unique
  vendorProfile   VendorProfile       @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  balance         Float               @default(0.0)
  pendingBalance  Float               @default(0.0)
  totalEarned     Float               @default(0.0)
  totalWithdrawn  Float               @default(0.0)
  transactions    WalletTransaction[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("vendor_wallet")
}

model WalletTransaction {
  id            String                @id @default(cuid())
  walletId      String
  wallet        VendorWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId       String?
  amount        Float
  type          WalletTransactionType
  description   String
  payoutMethod  String?
  payoutAccount String?
  createdAt     DateTime              @default(now())

  @@index([walletId])
  @@map("wallet_transaction")
}
