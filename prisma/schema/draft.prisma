/// Draft assignment persistence for students.
/// Lets a student save an in-progress assignment request and resume/publish it later.

model DraftAssignment {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String           @db.Text
  category          GigCategory      @default(ASSIGNMENT)
  subject           String
  type              AssignmentType   @default(SOFTCOPY)
  deadline          DateTime
  budgetMin         Float
  budgetMax         Float
  deliveryAddress   String?
  preferredCampus   String?
  preferredHandwritingStyle HandwritingStyle?
  sampleFileUrls    String[]         @default([])
  status            DraftStatus      @default(DRAFT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@map("draft_assignment")
}
