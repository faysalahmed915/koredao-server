model ProjectCheckpoint {
  id               String           @id @default(cuid())
  orderId          String
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title            String
  description      String?          @db.Text
  targetDate       DateTime?
  submittedFileUrl String?
  proofPhotoUrls   String[]         @default([])
  courierTracking  String?
  vendorNotes      String?          @db.Text
  clientFeedback   String?          @db.Text
  status           CheckpointStatus @default(PENDING)
  // Customer approval of the target DEFINITION itself (separate from work review).
  approvedAt       DateTime?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  chatMessages     ChatMessage[]

  @@index([orderId])
  @@index([status])
  @@map("project_checkpoint")
}
